# 한국 시간 기준 브리핑 알림 시각
BRIEFING_TIME=07:30
# 주간 점검 알림 시각 (매주 일요일)
WEEKLY_REVIEW_TIME=21:00

# 비워 두면 첫 실행 때 .data에 전용 접속 코드가 생성됩니다.
ASSISTANT_ACCESS_CODE=
ASSISTANT_PORT=8080
# 휴대폰 접속용 HTTPS 주소를 준비한 뒤 지정하세요.
ASSISTANT_ORIGIN=

NAVER_ID=
NAVER_APP_PASSWORD=
# 비워 두면 접근 가능한 모든 캘린더를 읽습니다. 여러 개는 쉼표로 구분합니다.
NAVER_CALENDARS=

# 사용할 RSS 주소를 쉼표로 구분해 입력하세요.
NEWS_FEEDS=https://www.aitimes.com/rss/allArticle.xml,https://www.yna.co.kr/rss/news.xml
# 네이버 뉴스 검색: 네이버 클라우드 콘솔 NAVER API HUB에서 뉴스 검색 Application을 등록하고 인증 정보를 입력하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_INTERESTS=AI,인공지능,기술

# 선택 사항. OpenJarvis를 아래 주소에서 실행하고 설치된 모델명을 지정하세요.
OPENJARVIS_URL=
OPENJARVIS_MODEL=
OPENJARVIS_API_KEY=

# 선택 사항. 콕콕 DB의 전체 경로와 내 예약 항목 ID만 지정하세요.
# Windows 경로는 슬래시(/)를 사용할 수 있습니다.
KOKKOK_DB=../site-booking/booking.db
KOKKOK_WATCH_IDS=
VAPID_CONTACT=mailto:assistant@example.invalid

# 학교 LMS(무들) 캘린더: LMS 로그인 후 /calendar/export.php 에서 "모든 일정 + 최근 및 다가올 60일"로 캘린더 URL을 받아 입력하세요.
# 주소에 일정 열람용 토큰이 들어 있으니 공개하지 마세요.
LMS_ICAL_URL=
